{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "confirm.js", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "scenarios/*.json", "use": "@vercel/static" },
    { "src": "quiz-editor/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/confirm/?$", "dest": "/confirm.html" },
    { "src": "^/api/auth/?$", "dest": "/api/auth.js" },
    { "src": "^/api/confirm/?$", "dest": "/api/confirm.js" },
    { "src": "^/api/lead/?$", "dest": "/api/lead.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/quiz-editor/?$", "dest": "/quiz-editor/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/1st-pain-quiz-styled.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/scenarios/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
